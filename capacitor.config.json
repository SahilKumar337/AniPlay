{
  "appId": "com.aniplay.aniplay",
  "appName": "AniPlay",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "initialFocus": false
  },

  "server": {
    "allowNavigation": [
      "*",
      "*.megaplay.buzz",
      "*.akirax.buzz",
      "*.shiora.top",
      "*.shiora.site",
      "*.quavex.top",
      "*.megap.top",
      "*.norami.site",
      "*.norami.top",
      "*.imgnex.com",
      "*.mikora.top",
      "*.vyrnex.top",
      "*.tiktokcdn.com",
      "*.echovideo.ru",
      "*.echovideo.to",
      "*.dpopdrop89.store",
      "*.roburnt10.store",
      "anilab-backend.onrender.com",
      "*.burntburst45.store",
      "aniwaves.ru",
      "animepahe.pw",
      "anineko.to",
      "anineko.es",
      "anikoto.cz",
      "megaplay.buzz",
      "vidtube.site",
      "vidwish.live",
      "raw.githubusercontent.com",
      "github.com",
      "objects.githubusercontent.com",
      "*.nexabloom.top",
      "*.streamzone1.site",
      "*.streamzone2.site",
      "*.streamzone3.site",
      "*.cdn-centaurus.com",
      "*.acek-cdn.com",
      "*.dramiyos.site",
      "*.playmogo.site",
      "graphql.anilist.co",
      "anilist.co",
      "*.silverorbit.top",
      "fetch.nexabloom.top",
      "*.savedly.net"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "privateKey": ""
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_name",
      "iconColor": "#7C3AED"
    }
  }
}
